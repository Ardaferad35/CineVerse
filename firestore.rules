rules_version = '2';

// CineVerse Firestore güvenlik kuralları.
//
// Çoğu yazım hâlâ doğrudan Android istemcisinden yapılıyor; bu yüzden bu
// dosya kod içindeki kontrollerin (ör. CommentRepository/NotificationRepository
// 'deki sahiplik ve alan doğrulamaları) TEK gerçek güvenlik sınırıdır —
// istemci tarafındaki kontroller sadece erken/anlamlı hata mesajı içindir,
// atlanabilir (reverse-engineer edilmiş bir istemci veya doğrudan REST/gRPC
// çağrısıyla).
//
// İSTİSNA: sunucu tarafı kod bu kuralların TAMAMINI bypass eder — hem
// functions/ altındaki Cloud Functions (Admin SDK) hem de asıl kullanılan
// supabase/functions/friend-push Edge Function'ı (Firebase servis hesabıyla
// Firestore REST). Bu yüzden "friends/" ve "notifications/" gibi bazı alt
// koleksiyonlarda client'a TAMAMEN KAPALI olan create işlemleri yine de
// sunucu üzerinden çalışıyor — bkz. ilgili yorum satırları.
//
// Deploy: `firebase deploy --only firestore:rules`

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- users/{uid} ---------------------------------------------------
    // Profil, herkese (giriş yapmış herkese) OKUNABİLİR olmalı çünkü yorum
    // listesi başka kullanıcıların fullName/avatarId alanlarını canlı okuyor
    // (bkz. CommentRepository.getComments). Yazma sadece sahibine açık;
    // ratingSum/ratingCount CommentRepository tarafından FieldValue.increment
    // ile güncelleniyor ama her zaman İŞLEMİ YAPAN kullanıcının kendi
    // belgesine yazılıyor (yorum sahiplik kontrolünden sonra), dolayısıyla
    // "sadece sahibi yazabilir" kuralı burada da geçerli.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      match /favorites/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /watchlist/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Arkadaşlık: gelen istekler. Belge ID'si GÖNDERENİN uid'i — bu yüzden
      // aynı kişi ikinci kez istek atarsa bu "create" değil "update" sayılır
      // ve create-only kural onu doğal olarak reddeder (üzerine yazma yok).
      // "status" alanı sadece sahibi (alıcı) tarafından pending -> accepted
      // olarak güncellenebilir; red = alıcının belgeyi silmesi.
      match /friendRequests/{fromUid} {
        allow read, delete: if isOwner(uid);
        allow create: if isSignedIn() && request.auth.uid == fromUid
          && isValidFriendRequest(request.resource.data);
        allow update: if isOwner(uid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status'])
          && request.resource.data.status == 'accepted';
      }

      // Arkadaş listesi: kabul edilince HER İKİ tarafta da karşılıklı bir
      // belge oluşur. Bu yazım artık SADECE onFriendRequestAccepted Cloud
      // Function'ı (Admin SDK, bu kuralları bypass eder) tarafından yapılıyor
      // — istemci artık "accept" işleminde friends/ belgesi yazmıyor, sadece
      // friendRequests/{fromUid}.status'u "accepted" yapıyor (bkz. yukarısı).
      // Bu yüzden client create'i tamamen kapalı: eskiden (Faz 1) client'ın
      // karşı tarafın friends/ listesine kendini ekleyebildiği, gerçek bir
      // "kabul" olmadan da çalışan bilinen açık böylece kapanıyor.
      match /friends/{friendUid} {
        allow read: if isOwner(uid);
        allow create: if false;
        // delete client'a AÇIK kalıyor (arkadaşlıktan çıkarma burada bir
        // güvenlik riski değil — ya kendi belgenizi ya da SİZİ arkadaş
        // listesine ekleyen tarafın belgesini siliyorsunuz, ikisi de zaten
        // meşru; bkz. FriendRepository.removeFriend'in çift taraflı silmesi).
        allow delete: if isSignedIn() && (isOwner(uid) || request.auth.uid == friendUid);
      }

      // FCM cihaz token'ları: sadece sahibi okuyabilir/yazabilir/silebilir.
      // Belge ID'si token'ın kendisi (çoklu cihaz desteği — her cihaz kendi
      // token'ını yazar/siler, başka bir cihazınkini etkilemez). Cloud
      // Functions bu koleksiyonu SADECE okur (push göndermek için), hiç
      // yazmaz; bayat token temizliği de Admin SDK ile yapıldığından rules'ı
      // bypass eder.
      match /fcmTokens/{token} {
        allow read, write: if isOwner(uid);
      }

      // Bildirimler: SADECE sahibi okuyabilir/silebilir. "create" HİÇBİR
      // istemciye açık değil — bildirim belgelerini artık yalnızca
      // supabase/functions/friend-push Edge Function'ı bir servis hesabıyla
      // (bu kuralları bypass ederek) yazıyor; arkadaşlık isteği/kabulü VE
      // yorum yanıtı için. Eskiden create, dar bir alan doğrulamasıyla her
      // giriş yapmış kullanıcıya açıktı (yorum yanıtı bildirimini yanıtı
      // yazanın cihazı yazıyordu) — bu, herkesin herkesin bildirim kutusuna
      // istediği başlık/metni yazabilmesi anlamına geliyordu; kapatıldı.
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create: if false;
        // Güncelleme sadece bildirim sahibine ve sadece isRead alanına açık
        // (markAsRead/markAllAsRead) — içerik sonradan değiştirilemez.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
      }
    }

    // --- usernames/{username} --------------------------------------------
    // Kullanıcı adı tekliğini garanti eden "claim" belgeleri. "update" hiçbir
    // zaman izinli değil — kullanıcı adı değişikliği eski claim'i silip yenisini
    // oluşturmak şeklinde yapılır, böylece bir isim asla üzerine yazılamaz.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasOnly(['fromUid', 'fromUsername', 'fromFullName', 'fromAvatarId', 'status', 'createdAt'])
        && data.fromUid == request.auth.uid
        && data.fromUsername is string && data.fromUsername.size() > 0 && data.fromUsername.size() <= 20
        && data.fromFullName is string && data.fromFullName.size() <= 150
        && data.fromAvatarId is string
        && data.status == 'pending'
        && data.createdAt is int;
    }

    function isValidFriendDoc(data) {
      return data.keys().hasOnly(['friendUid', 'username', 'fullName', 'avatarId', 'since'])
        && data.friendUid is string
        && data.username is string && data.username.size() > 0 && data.username.size() <= 20
        && data.fullName is string && data.fullName.size() <= 150
        && data.avatarId is string
        && data.since is int;
    }

    // --- movies/{movieId}/comments/{commentId} --------------------------
    // --- tv_shows/{tvId}/comments/{commentId} ---------------------------
    // Yorumlar herkese (giriş yapmış herkese) okunabilir; oluşturma sadece
    // kendi userId'niz ile, güncelleme/silme SADECE yorumun asıl sahibine
    // açık (CommentRepository.updateComment/deleteComment'teki istemci
    // tarafı kontrolün sunucu tarafı karşılığı — asıl güvenlik sınırı BURASI).
    match /movies/{movieId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidComment(request.resource.data, request.auth.uid);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && isValidComment(request.resource.data, request.auth.uid);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /tv_shows/{tvId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidComment(request.resource.data, request.auth.uid);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && isValidComment(request.resource.data, request.auth.uid);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isValidComment(data, uid) {
      return data.userId == uid
        && data.text is string && data.text.size() <= 2000
        && data.rating is int && data.rating >= 0 && data.rating <= 5;
    }

    // --- movie_ratings/{movieId} -----------------------------------------
    // --- tv_show_ratings/{tvId} -------------------------------------------
    // Film/dizi başına tek bir toplu (aggregate) belge; CommentRepository,
    // bir kullanıcı KENDİ yorumunu ekleyip/düzenleyip/sildiğinde bu ortak
    // belgeyi yeniden hesaplayıp yazıyor. Belirli bir sahibi olmadığından
    // yazma sahiplikle değil, şekil (shape) doğrulamasıyla sınırlanıyor.
    match /movie_ratings/{movieId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidRatingAggregate(request.resource.data);
    }

    match /tv_show_ratings/{tvId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidRatingAggregate(request.resource.data);
    }

    function isValidRatingAggregate(data) {
      return data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5
        && data.ratingCount is int && data.ratingCount >= 0;
    }
  }
}
